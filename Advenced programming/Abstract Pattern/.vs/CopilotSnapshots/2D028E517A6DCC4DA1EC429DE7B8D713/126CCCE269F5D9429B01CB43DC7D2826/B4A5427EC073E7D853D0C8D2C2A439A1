namespace Abstract_Pattern
{
    internal class Program
    {
        static void Main(string[] args)
        {
            // Traffic Light State Pattern (translated from Python example)
            var audioPlayer = new AudioPlayer(new GreenState());
            audioPlayer.PreviousState();
            audioPlayer.NextState();
            audioPlayer.NextState();
            audioPlayer.NextState();
            audioPlayer.NextState();
            audioPlayer.NextState();
            audioPlayer.PreviousState();
            audioPlayer.PreviousState();
            audioPlayer.PreviousState();
            audioPlayer.PreviousState();
            audioPlayer.PreviousState();
            audioPlayer.PreviousState();
            audioPlayer.PreviousState();
        }
    }

    internal abstract class IState
    {
        internal AudioPlayer TrafficLight { get; set; }

        internal abstract void StopState();
        internal abstract void PauseState();
        internal abstract void PlayState();
    }

    internal class AudioPlayer
    {
        private IState _state;

        public AudioPlayer(IState state)
        {
            SetState(state);
        }

        public void SetState(IState state)
        {
            _state = state;
            _state.TrafficLight = this;
        }

        public void NextState() => _state.StopState();
        public void PreviousState() => _state.PauseState();
    }

    internal class GreenState : IState
    {
        internal override void StopState()
        {
            Console.WriteLine("From GreenState to YellowState");
            TrafficLight.SetState(new YellowState());
        }

        internal override void PauseState()
        {
            Console.WriteLine("Green State");
        }
    }

    internal class YellowState : IState
    {
        internal override void StopState()
        {
            Console.WriteLine("From YellowState to RedState");
            TrafficLight.SetState(new RedState());
        }

        internal override void PauseState()
        {
            Console.WriteLine("From YellowState to GreenState");
            TrafficLight.SetState(new GreenState());
        }
    }

    internal class RedState : IState
    {
        internal override void StopState()
        {
            Console.WriteLine("Red State");
        }

        internal override void PauseState()
        {
            Console.WriteLine("From Red State to YellowState");
            TrafficLight.SetState(new YellowState());
        }
    }
}
